        <mxCell id="59Jmw2dpT3aq7HsNmHRe-85" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;fontSize=10;" edge="1" parent="1" source="59Jmw2dpT3aq7HsNmHRe-87" target="59Jmw2dpT3aq7HsNmHRe-89">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="59Jmw2dpT3aq7HsNmHRe-86" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=10;" edge="1" parent="1" source="59Jmw2dpT3aq7HsNmHRe-87" target="59Jmw2dpT3aq7HsNmHRe-90">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="59Jmw2dpT3aq7HsNmHRe-87" value="&lt;span id=&quot;docs-internal-guid-3ccb9f6a-7fff-7f46-d8be-888557d7b7c7&quot;&gt;&lt;div style=&quot;border-color: var(--border-color);&quot;&gt;Related to Changes&lt;/div&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="410" y="810" width="110" height="40" as="geometry" />
        </mxCell>
        <mxCell id="59Jmw2dpT3aq7HsNmHRe-88" value="&lt;h6&gt;&lt;p class=&quot;p1&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;Sanity Test&lt;/font&gt;&lt;/p&gt;&lt;p class=&quot;p2&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(51, 51, 51), rgb(193, 193, 193)); font-size: 10px; font-weight: normal;&quot;&gt;Verify if the modified or newly added functionalities are working as expected. It is typically performed after a smoke test and before more in-depth testing, such as regression testing.&lt;/span&gt;&lt;/p&gt;&lt;p class=&quot;p2&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;/h6&gt;" style="text;html=1;strokeColor=#666666;fillColor=#f5f5f5;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="570" y="750" width="180" height="100" as="geometry" />
        </mxCell>
        <mxCell id="59Jmw2dpT3aq7HsNmHRe-89" value="&lt;h6&gt;&lt;p class=&quot;p1&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;Regression Test&lt;/font&gt;&lt;/p&gt;&lt;p class=&quot;p1&quot;&gt;&lt;font style=&quot;font-size: 10px; font-weight: normal;&quot;&gt;Ensure that recent changes in the code have not negatively impacted the existing functionalities of the system. It involves re-running previous test cases to confirm that nothing has been broken.&lt;/font&gt;&lt;/p&gt;&lt;/h6&gt;" style="text;html=1;strokeColor=#666666;fillColor=#f5f5f5;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="570" y="870" width="170" height="110" as="geometry" />
        </mxCell>
        <mxCell id="59Jmw2dpT3aq7HsNmHRe-90" value="&lt;h6&gt;&lt;p class=&quot;p1&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;Retest&lt;/font&gt;&lt;/p&gt;&lt;p class=&quot;p2&quot;&gt;&lt;span style=&quot;font-size: 10px; font-weight: normal; background-color: transparent; color: light-dark(rgb(51, 51, 51), rgb(193, 193, 193));&quot;&gt;Verify if a defect that was fixed in a previous version of the system has truly been resolved. It is essentially a repetition of the tests performed earlier, focusing on areas where errors were found.&lt;/span&gt;&lt;/p&gt;&lt;/h6&gt;" style="text;html=1;strokeColor=#666666;fillColor=#f5f5f5;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="570" y="990" width="170" height="110" as="geometry" />
        </mxCell>
        <mxCell id="59Jmw2dpT3aq7HsNmHRe-91" value="&lt;h6&gt;&lt;p class=&quot;p1&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;Smoke Test&lt;/font&gt;&lt;/p&gt;&lt;p class=&quot;p1&quot;&gt;&lt;span style=&quot;font-size: 10px; font-weight: normal; background-color: transparent; color: light-dark(rgb(51, 51, 51), rgb(193, 193, 193));&quot;&gt;Quickly verify if the most critical functions of an application are working. This test is performed on an early build of the code to ensure that the application is stable enough for further detailed testing.&lt;/span&gt;&lt;/p&gt;&lt;/h6&gt;" style="text;html=1;strokeColor=#666666;fillColor=#f5f5f5;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="570" y="610" width="170" height="110" as="geometry" />
        </mxCell>
