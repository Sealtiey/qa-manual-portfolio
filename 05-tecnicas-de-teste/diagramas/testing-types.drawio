        <mxCell id="59Jmw2dpT3aq7HsNmHRe-78" value="&lt;p style=&quot;line-height: 0&quot;&gt;&lt;/p&gt;&lt;h6&gt;&lt;font style=&quot;font-size: 12px&quot;&gt;Unit (Component)&lt;/font&gt;&lt;/h6&gt;&lt;h6&gt;&lt;span style=&quot;font-size: 10px; background-color: transparent; color: light-dark(rgb(51, 51, 51), rgb(193, 193, 193)); font-weight: normal;&quot;&gt;Testing of separate small modules on the code level. Usually by developers.&lt;/span&gt;&lt;/h6&gt;&lt;p&gt;&lt;/p&gt;" style="text;html=1;strokeColor=#666666;fillColor=#f5f5f5;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="568" y="69" width="142" height="91" as="geometry" />
        </mxCell>
        <mxCell id="59Jmw2dpT3aq7HsNmHRe-79" value="&lt;h6&gt;&lt;p class=&quot;p1&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;Integration Testing&amp;nbsp;&lt;/font&gt;&lt;/p&gt;&lt;p class=&quot;p1&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(51, 51, 51), rgb(193, 193, 193)); font-weight: normal;&quot;&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;Verifies the interaction between components or modules.&lt;/font&gt;&lt;/span&gt;&lt;/p&gt;&lt;/h6&gt;" style="text;html=1;strokeColor=#666666;fillColor=#f5f5f5;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="568" y="189" width="120" height="71" as="geometry" />
        </mxCell>
        <mxCell id="59Jmw2dpT3aq7HsNmHRe-80" value="&lt;h6&gt;&lt;p class=&quot;p1&quot;&gt;&lt;font style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;System Testing&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;p class=&quot;p1&quot;&gt;&lt;font style=&quot;&quot;&gt;&lt;span style=&quot;font-weight: normal;&quot;&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;Tests the complete system, validating integrated functionalities.&lt;/font&gt;&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;/h6&gt;" style="text;html=1;strokeColor=#666666;fillColor=#f5f5f5;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="568" y="309" width="122" height="71" as="geometry" />
        </mxCell>
        <mxCell id="59Jmw2dpT3aq7HsNmHRe-81" value="&lt;h6&gt;&lt;p class=&quot;p1&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;Acceptance Testing&lt;/font&gt;&lt;/p&gt;&lt;p class=&quot;p1&quot;&gt;&lt;font style=&quot;font-size: 10px; font-weight: normal;&quot;&gt;Validates if the system meets the client’s/user’s requirements.&lt;/font&gt;&lt;/p&gt;&lt;/h6&gt;" style="text;html=1;strokeColor=#666666;fillColor=#f5f5f5;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="568" y="429" width="122" height="71" as="geometry" />
